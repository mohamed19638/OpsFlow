{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PublicRegistration": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=opsflow_db;Username=opsflow_user;Password=opsflow_password;"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "opsflow.events",
    "Queue": "opsflow.notifications",
    "DeadLetterExchange": "opsflow.events.dlx",
    "DeadLetterQueue": "opsflow.notifications.dlq",
    "MaxDeliveryAttempts": 3
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "OpsFlow",
    "Audience": "OpsFlowClients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  }
}
