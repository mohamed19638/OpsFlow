# Copy this file to secrets.env, replace every value, and never commit secrets.env.
# Use letters and numbers for Redis and RabbitMQ passwords so connection-string
# delimiters such as commas and colons do not need escaping.
POSTGRES_USER=opsflow_user
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
REDIS_PASSWORD=replace-with-a-long-random-letters-and-numbers-password
RABBITMQ_USER=opsflow
RABBITMQ_PASSWORD=replace-with-a-long-random-rabbitmq-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters-for-jwt-signing
